{
  "cli": {
    "version": ">= 26.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "production": {
      "distribution": "store",
      "credentialsSource": "remote",
      "autoIncrement": true,
      "environment": "production",
      "node": "24.19.0",
      "ios": { "simulator": false, "image": "latest" }
    },
    "ios-simulator": {
      "distribution": "internal",
      "environment": "preview",
      "node": "24.19.0",
      "ios": { "simulator": true, "image": "latest" }
    }
  },
  "submit": { "production": { "ios": {} } }
}
